<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaTioAlisson.Presentation.AppMaui.Views.AcessoPage"
             xmlns:vm="clr-namespace:AcademiaTioAlisson.Presentation.AppMaui.ViewModels"
             xmlns:converters="clr-namespace:AcademiaTioAlisson.Presentation.AppMaui.Converters"
             x:DataType="vm:AcessoViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Spacing="16" Padding="15">

            <!-- Card 1: Seletor de Modo (Aluno / Colaborador) -->
            <Border Style="{StaticResource CardBorder}">
                <StackLayout Spacing="12" Padding="14">
                    <Label Text="Controle de Acesso / Catraca" Style="{StaticResource SubHeadline}" HorizontalOptions="Center"/>
                    <Label Text="Selecione se o acesso é de um Aluno ou Colaborador:" FontSize="12" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Aluno" Command="{Binding SelecionarAlunoCommand}"
                                Style="{StaticResource ButtonPrimary}" HeightRequest="45">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe80c;" />
                            </Button.ImageSource>
                        </Button>

                        <Button Grid.Column="1" Text="Colaborador" Command="{Binding SelecionarColaboradorCommand}"
                                Style="{StaticResource ButtonSecondary}" HeightRequest="45">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xea67;" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <Label Text="{Binding ModoSelecionadoTexto}" FontSize="12" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" HorizontalOptions="Center"/>
                </StackLayout>
            </Border>

            <!-- Card 2: Localizar Pessoa -->
            <Border Style="{StaticResource CardBorder}">
                <StackLayout Spacing="10" Padding="14">
                    <Label Text="Localizar Pessoa" Style="{StaticResource SubHeadline}" HorizontalOptions="Center"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" Text="{Binding FiltroTexto}" Placeholder="Buscar por nome ou CPF..."
                               ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding FiltrarPessoasCommand}"/>
                        <Button Grid.Column="1" Command="{Binding FiltrarPessoasCommand}" Style="{StaticResource ButtonPrimary}" WidthRequest="50">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <Label Text="{Binding LabelSelecaoTexto}" FontAttributes="Bold" FontSize="13"/>
                    <Picker Title="Toque para escolher..." ItemsSource="{Binding PessoasFiltradas}" SelectedItem="{Binding SelectedPessoa}"/>
                </StackLayout>
            </Border>

            <!-- Card 3: Identificação e Liberação -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasPessoaSelecionada}">
                <StackLayout Spacing="14" Padding="14">
                    <Label Text="Identificação e Liberação" Style="{StaticResource SubHeadline}" HorizontalOptions="Center"/>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0" HeightRequest="68" WidthRequest="68" StrokeShape="RoundRectangle 34"
                                Stroke="{StaticResource Primary}" StrokeThickness="2">
                            <Image Source="{Binding SelectedPessoa.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                   Aspect="AspectFill" HeightRequest="68" WidthRequest="68"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding SelectedPessoa.Nome}" FontAttributes="Bold" FontSize="16"/>
                            <Label Text="{Binding SelectedPessoa.Cpf, StringFormat='CPF: {0}'}" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                            <Border Padding="8,3" StrokeShape="RoundRectangle 6" HorizontalOptions="Start"
                                    BackgroundColor="{AppThemeBinding Light=#E0E7FF, Dark=#1E1B4B}">
                                <Label Text="{Binding StatusAcademiaTexto}" FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#3730A3, Dark=#A5B4FC}"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="{Binding BotaoAcaoTexto}" Command="{Binding RegistrarAcessoCommand}"
                            Style="{StaticResource ButtonPrimary}" HeightRequest="48">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe897;" />
                        </Button.ImageSource>
                    </Button>
                </StackLayout>
            </Border>

            <!-- Banner de Retorno (Acesso Negado / Entrada Autorizada / Saída Registrada) -->
            <Border IsVisible="{Binding HasFeedback}" Padding="14" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light=#DCFCE7, Dark=#064E3B}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="&#xe876;" FontFamily="MaterialIcons" FontSize="24"
                           TextColor="{AppThemeBinding Light=#166534, Dark=#86EFAC}" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{Binding FeedbackTitulo}" FontAttributes="Bold" FontSize="14"
                               TextColor="{AppThemeBinding Light=#166534, Dark=#86EFAC}"/>
                        <Label Text="{Binding FeedbackMensagem}" FontSize="12" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#14532D, Dark=#BBF7D0}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Card 4: Acessos Registrados Hoje -->
            <Border Style="{StaticResource CardBorder}">
                <StackLayout Spacing="10" Padding="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Acessos Registrados Hoje" Style="{StaticResource SubHeadline}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="Atualizar" Command="{Binding AtualizarHistoricoHojeCommand}"
                                Style="{StaticResource ButtonSecondary}" HeightRequest="36" Padding="12,0">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5d5;" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <CollectionView ItemsSource="{Binding AcessosHoje}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhum acesso registrado hoje." FontSize="12" HorizontalOptions="Center" Margin="0,10"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AcessoRegistroItem">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="0,8">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding NomePessoa}" FontAttributes="Bold" FontSize="14"/>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Horario}" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Mensagem}"
                                           FontSize="12" LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Border>

            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HorizontalOptions="Center"/>
        </StackLayout>
    </ScrollView>
</ContentPage>